# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube a git.

# URL pública del sitio (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la uses en código del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Tus integraciones > Credenciales)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta para verificar la firma de los webhooks
MERCADOPAGO_WEBHOOK_SECRET=
